{
  "name": "react-fast-compare",
  "version": "3.2.2",
  "description": "Fastest deep equal comparison for React. Great for React.memo & shouldComponentUpdate. Also really fast general-purpose deep comparison.",
  "main": "index.js",
  "typings": "index.d.ts",
  "scripts": {
    "preversion": "pnpm check",
    "check": "pnpm format && pnpm lint && pnpm types:check && pnpm test && pnpm pack:check",
    "benchmark": "node benchmark",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix",
    "types:check": "node scripts/types-check.mjs",
    "test-browser": "karma start test/browser/karma.conf.js",
    "test-node": "mocha \"test/node/*.spec.js\"",
    "test-node-cov": "nyc mocha \"test/node/*.spec.js\"",
    "test": "builder concurrent --buffer test-node-cov test-browser",
    "compress": "terser --compress --mangle=\"toplevel:true\" -- index.js",
    "size-min-gz": "pnpm -s compress | gzip -9 | wc -c",
    "changeset": "changeset",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/react-fast-compare"
  },
  "keywords": [
    "fast",
    "equal",
    "react",
    "compare",
    "shouldComponentUpdate",
    "deep-equal"
  ],
  "author": "Chris Bolin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FormidableLabs/react-fast-compare/issues"
  },
  "homepage": "https://github.com/FormidableLabs/react-fast-compare",
  "packageManager": "pnpm@12.16.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^9.0.1",
    "@testing-library/preact": "^3.2.3",
    "@types/node": "^18.15.0",
    "@types/react": "^19.3.0",
    "assert": "^2.0.0",
    "babel-loader": "^9.1.2",
    "benchmark": "^2.1.4",
    "builder": "^5.0.0",
    "core-js": "^3.29.0",
    "fast-deep-equal": "3.1.3",
    "jsdom": "^21.1.0",
    "jsdom-global": "^3.0.2",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.1.1",
    "karma-firefox-launcher": "^2.1.2",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-safari-launcher": "^1.0.0",
    "karma-webpack": "^5.0.0",
    "lodash": "^4.17.10",
    "mocha": "^11.8.0",
    "nano-equal": "^2.0.2",
    "nyc": "^15.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "preact": "^10.13.1",
    "process": "^0.11.10",
    "publint": "0.3.25",
    "react": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "shallow-equal-fuzzy": "0.0.2",
    "sinon": "^15.0.1",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "webpack": "^5.76.0"
  },
  "nyc": {
    "exclude": [
      "**/test/**",
      "node_modules"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "types": "index.d.ts"
}
