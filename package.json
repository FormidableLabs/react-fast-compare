{
  "name": "react-fast-compare",
  "version": "3.2.2",
  "description": "Fastest deep equal comparison for React. Great for React.memo & shouldComponentUpdate. Also really fast general-purpose deep comparison.",
  "main": "index.js",
  "typings": "index.d.ts",
  "scripts": {
    "check": "pnpm format && pnpm lint && pnpm lint:gha && pnpm types:check && pnpm test && pnpm pack:check",
    "benchmark": "node benchmark",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix",
    "lint:gha": "node scripts/lint-gha.mjs",
    "types:check": "node scripts/types-check.mjs",
    "test": "vitest run",
    "changeset": "changeset",
    "pack:check": "node scripts/pack-check.mjs",
    "size": "node scripts/size.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/react-fast-compare"
  },
  "keywords": [
    "fast",
    "equal",
    "react",
    "compare",
    "shouldComponentUpdate",
    "deep-equal"
  ],
  "author": "Chris Bolin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FormidableLabs/react-fast-compare/issues"
  },
  "homepage": "https://github.com/FormidableLabs/react-fast-compare",
  "packageManager": "pnpm@12.16.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "benchmark": "^2.1.4",
    "fast-deep-equal": "3.1.3",
    "jsdom": "^30.1.3",
    "lodash": "^4.17.10",
    "nano-equal": "^2.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "^1.64.1",
    "preact": "^11.1.1",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shallow-equal-fuzzy": "0.0.2",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "types": "index.d.ts"
}
